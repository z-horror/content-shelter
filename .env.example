# ── Обязательные ──────────────────────────────────────────────────────────────

# Токен бота от @BotFather
BOT_TOKEN=

# Канал, куда публикуем. Публичный: @username. Приватный: числовой ID вида -100...
# Бот обязан быть админом канала с правом «Публикация сообщений».
CHANNEL_ID=

# Приватный чат/группа, куда падают заявки на модерацию.
# Бот обязан быть там админом (для канала — с правом постинга).
ADMIN_GROUP_ID=

# Telegram ID админов через запятую. Только они видят админку и кнопки модерации.
# Свой ID можно узнать у @userinfobot.
ADMIN_USER_IDS=

# ── Необязательные ────────────────────────────────────────────────────────────

# Топик в админ-группе для карточек заявок (только если включены «Темы»).
# Оставь пустым, если топики не нужны.
ADMIN_TOPIC_ID=

# Путь к файлу базы. В Docker переопределяется на /data/neuroslop.sqlite3.
# DB_PATH=/data/neuroslop.sqlite3

# Таймзона для отложенных публикаций и отображения времени.
TZ=Europe/Moscow
